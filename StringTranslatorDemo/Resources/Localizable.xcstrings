    "Break down language barriers in real-time conversations. Stay connected, even offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break down language barriers in real-time conversations. Stay connected, even offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera las barreras del idioma en conversaciones en tiempo real. Mantente conectado, incluso sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éliminez les barrières linguistiques dans les conversations en temps réel. Restez connecté, même hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक समय की बातचीत में भाषा संबंधी बाधाओं को तोड़ें। ऑफ़लाइन रहते हुए भी जुड़े रहें."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打破实时对话中的语言障碍。保持连接，即使离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打破即時對話中的語言障礙。保持連接，即使離線。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "打破即時對話中的語言障礙。保持連接，即使離線。"
          }
        }
      }
    },
