    "Scan text in real-time with your camera and get instant translations, wherever you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan text in real-time with your camera and get instant translations, wherever you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea texto en tiempo real con tu cámara y obtén traducciones instantáneas, estés donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérisez du texte en temps réel avec votre appareil photo et obtenez des traductions instantanées, où que vous soyez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कैमरे से वास्तविक समय में टेक्स्ट को स्कैन करें और आप जहां भी हों, तत्काल अनुवाद प्राप्त करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论您身在何处，都可以使用相机实时扫描文本并获得即时翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論您身在何處，都可以使用相機即時掃描文字並獲得即時翻譯。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無論您身在何處，都可以使用相機即時掃描文字並獲得即時翻譯。"
          }
        }
      }
    },
    "Scan text using your camera and get instant translations. Available offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan text using your camera and get instant translations. Available offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize texto com sua câmera e obtenha traduções instantâneas. Disponível offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérisez du texte à l'aide de votre appareil photo et obtenez des traductions instantanées. Disponible hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कैमरे का उपयोग करके टेक्स्ट को स्कैन करें और तुरंत अनुवाद प्राप्त करें। ऑफ़लाइन उपलब्ध है."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机扫描文本并获得即时翻译。离线可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機掃描文字並獲得即時翻譯。離線可用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機掃描文字並獲得即時翻譯。離線可用。"
          }
        }
      }
    },
