    "Your bookmarks will be erased, but your history stays. Do you want to continue?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bookmarks will be erased, but your history stays. Do you want to continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nossos favoritos serão apagados, mas seu histórico permanecerá. Deseja continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos favoris seront effacés, mais votre historique restera. Voulez-vous continuer ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बुकमार्क मिटा दिए जाएंगे, लेकिन आपका इतिहास बना रहेगा। क्या आप जारी रखना चाहते हैं?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的书签将被删除，但您的历史记录将保留。您想继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的書籤將被刪除，但您的歷史記錄將保留。您想繼續嗎？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "您的書籤將被刪除，但您的歷史記錄將保留。您想繼續嗎？"
          }
        }
      }
    },
