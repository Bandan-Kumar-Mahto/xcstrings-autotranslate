    "Translate text into over 200 languages, anytime you need it, no matter where you are — even offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate text into over 200 languages, anytime you need it, no matter where you are — even offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce texto a más de 200 idiomas, cuando lo necesites, estés donde estés, incluso sin conexión a internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduisez du texte dans plus de 200 langues, à tout moment, où que vous soyez, même hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट का 200 से अधिक भाषाओं में अनुवाद करें, जब भी आपको इसकी आवश्यकता हो, चाहे आप कहीं भी हों - ऑफ़लाइन भी।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文本翻译成 200 多种语言，无论您身在何处，只要您需要，甚至离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將文字翻譯成 200 多種語言，無論您身在何處，只要您需要，甚至離線。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將文字翻譯成 200 多種語言，無論您身在何處，只要您需要，甚至離線。"
          }
        }
      }
