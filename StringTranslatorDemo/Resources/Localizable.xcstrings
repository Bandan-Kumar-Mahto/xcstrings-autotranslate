        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्वनि सुविधाओं का उपयोग करने के लिए कृपया अपनी डिवाइस सेटिंग में माइक्रोफ़ोन एक्सेस सक्षम करें"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在您的设备设置中启用麦克风访问权限以使用语音功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在您的裝置設定中啟用麥克風存取權限以使用語音功能"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在您的裝置設定中啟用麥克風存取權限以使用語音功能"
          }
        }
      }
    },
