    "Speak into the mic, and your words will\\nbe translated into the preferred language": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak into the mic, and your words will\\nbe translated into the preferred language"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale no microfone e suas palavras serão traduzidas para o idioma de sua preferência"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez dans le micro et vos mots seront\\ntraduits dans la langue de votre choix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक में बोलें, और आपके शब्दों का पसंदीदा भाषा में अनुवाद किया जाएगा"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对着麦克风说话，您的话\\n将被翻译成首选语言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對著麥克風說話，您的話\\n將被翻譯成首選語言"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對著麥克風說話，您的話\\n將被翻譯成首選語言"
          }
        }
      }
    },
