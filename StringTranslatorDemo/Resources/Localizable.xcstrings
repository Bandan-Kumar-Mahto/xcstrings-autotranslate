        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级到高级版以获得增强的体验，无限制地访问高级功能和完整的优势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級到高級版以獲得增強的體驗，無限制地存取高級功能和完整的優勢"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "升級到高級版以獲得增強的體驗，無限制地存取高級功能和完整的優勢"
          }
