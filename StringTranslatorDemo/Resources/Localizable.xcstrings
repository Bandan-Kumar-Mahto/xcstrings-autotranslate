    "Easily translate text from photos, whether it’s a sign, menu, or document. It works offline whenever you need it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily translate text from photos, whether it’s a sign, menu, or document. It works offline whenever you need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce fácilmente el texto de las fotos, ya sean carteles, menús o documentos. Funciona sin conexión cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduisez facilement du texte à partir de photos, qu'il s'agisse d'un panneau, d'un menu ou d'un document. Il fonctionne hors ligne chaque fois que vous en avez besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो से टेक्स्ट का आसानी से अनुवाद करें, चाहे वह कोई चिह्न, मेनू या दस्तावेज़ हो। जब भी आपको इसकी आवश्यकता हो यह ऑफ़लाइन काम करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻松翻译照片中的文本，无论是标志、菜单还是文档。只要您需要，它就可以离线工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕鬆翻譯照片中的文本，無論是標誌、菜單還是文件。只要您需要，它就可以離線工作。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "輕鬆翻譯照片中的文本，無論是標誌、菜單還是文件。只要您需要，它就可以離線工作。"
          }
        }
      }
    },
    "Enjoy uninterrupted real-time translations for conversations. Available offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy uninterrupted real-time translations for conversations. Available offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite traduções ininterruptas em tempo real para conversas. Disponível offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez de traductions ininterrompues en temps réel pour les conversations. Disponible hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत के लिए निर्बाध वास्तविक समय अनुवाद का आनंद लें। ऑफ़लाइन उपलब्ध है."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "享受不间断的实时对话翻译。离线可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "享受不間斷的即時對話翻譯。離線可用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "享受不間斷的即時對話翻譯。離線可用。"
          }
        }
      }
    },
